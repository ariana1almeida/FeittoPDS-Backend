generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int           @id @default(autoincrement())
  firebaseUid     String        @unique
  firstName       String
  lastName        String
  phone           String
  picture         String?
  userType        UserType
  city            City
  state           State
  neighborhood    String
  clientData      ClientData?
  providerData    ProviderData?
  createdServices Service[]     @relation("ClientServices")

  totalRating     Int   @default(0)
  numberOfRatings Int   @default(0)
  averageRating   Float @default(0)

  ratingsGiven    Ratings[]  @relation("RatingsGiven")
  ratingsReceived Ratings[]  @relation("RatingsReceived")
  proposals       Proposal[] @relation("ProposalOwner")

  @@map("Usuario")
}

model ClientData {
  id          Int    @id @default(autoincrement())
  street      String
  houseNumber Int
  reference   String
  userId      Int    @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderData {
  id          Int          @id @default(autoincrement())
  professions Profession[]
  userId      Int          @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          Int           @id @default(autoincrement())
  picture     String
  title       String
  description String
  status      ServiceStatus @default(OPEN)
  category    Profession
  city        City
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId Int
  client   User @relation("ClientServices", fields: [clientId], references: [id], onDelete: Cascade)

  proposals    Proposal[] @relation("ProposedToService")
  ratedService Ratings[]  @relation("ratedService")

  @@map("Servico")
}

model Proposal {
  id         Int @id @default(autoincrement())
  serviceId  Int
  providerId Int

  accepted       Boolean  @default(false)
  estimatedPrice Float
  estimatedDays  Int
  description    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service  Service @relation("ProposedToService", fields: [serviceId], references: [id])
  provider User    @relation("ProposalOwner", fields: [providerId], references: [id])
}

model Ratings {
  id          Int      @id @default(autoincrement())
  ratedById   Int
  ratedUserId Int
  serviceId   Int?
  score       Int
  comment     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service   Service? @relation("ratedService", fields: [serviceId], references: [id])
  ratedBy   User     @relation("RatingsGiven", fields: [ratedById], references: [id])
  ratedUser User     @relation("RatingsReceived", fields: [ratedUserId], references: [id])

  @@unique([ratedById, ratedUserId])
}

enum UserType {
  CLIENT
  PROVIDER
}

enum City {
  CAPAO_DA_CANOA
  XANGRI_LA
  TRAMANDAI
  IMBE
  CURUMIM
}

enum State {
  RS
}

enum Profession {
  ELECTRICIAN
  PLUMBER
  CARPENTER
  PAINTER
  MASON
  OTHERS
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
