generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  firebaseUid     String        @unique
  firstName       String
  lastName        String
  phone           String
  picture         String?
  userType        UserType
  city            City
  state           State
  neighborhood    String
  clientData      ClientData?
  providerData    ProviderData?
  createdServices Service[]     @relation("ClientServices")

  totalRating     Int   @default(0)
  numberOfRatings Int   @default(0)
  averageRating   Float @default(0)

  ratingsGiven     Ratings[]  @relation("RatingsGiven")
  ratingsReceived  Ratings[]  @relation("RatingsReceived")
  proposals        Proposal[] @relation("ProposalOwner")
  ChatRoomClient   ChatRoom[] @relation("ChatRoomClient")
  ChatRoomProvider ChatRoom[] @relation("ChatRoomProvider")

  @@map("Usuario")
}

model ClientData {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  street      String
  houseNumber Int
  reference   String
  userId      String @unique @db.ObjectId
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderData {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  professions Profession[]
  userId      String       @unique @db.ObjectId
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  picture     String
  title       String
  description String
  status      ServiceStatus @default(OPEN)
  category    Profession
  city        City
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clientId String @db.ObjectId
  client   User   @relation("ClientServices", fields: [clientId], references: [id], onDelete: Cascade)

  proposals    Proposal[] @relation("ProposedToService")
  ratedService Ratings[]  @relation("ratedService")

  @@map("Servico")
}

model Proposal {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  serviceId  String @db.ObjectId
  providerId String @db.ObjectId

  accepted       Boolean  @default(false)
  estimatedPrice Float
  estimatedDays  Int
  description    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service  Service @relation("ProposedToService", fields: [serviceId], references: [id])
  provider User    @relation("ProposalOwner", fields: [providerId], references: [id])
}

model Ratings {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ratedById   String   @db.ObjectId
  ratedUserId String   @db.ObjectId
  serviceId   String?  @db.ObjectId
  score       Int
  comment     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service   Service? @relation("ratedService", fields: [serviceId], references: [id])
  ratedBy   User     @relation("RatingsGiven", fields: [ratedById], references: [id])
  ratedUser User     @relation("RatingsReceived", fields: [ratedUserId], references: [id])

  @@unique([ratedById, ratedUserId])
}

model ChatRoom {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  clientId   String
  providerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   User          @relation("ChatRoomClient", fields: [clientId], references: [firebaseUid])
  provider User          @relation("ChatRoomProvider", fields: [providerId], references: [firebaseUid])
  messages ChatMessage[]

  @@unique([clientId, providerId])
}

model ChatMessage {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  chatRoomId String   @db.ObjectId
  senderId   String
  content    String
  timestamp  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
}

enum UserType {
  CLIENT
  PROVIDER
}

enum City {
  CAPAO_DA_CANOA
  XANGRI_LA
  TRAMANDAI
  IMBE
  CURUMIM
}

enum State {
  RS
}

enum Profession {
  ELECTRICIAN
  PLUMBER
  CARPENTER
  PAINTER
  MASON
  OTHERS
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
